    "check": "bun run typecheck && bun run lint",
    "check:fast": "bun run typecheck && bun run lint",
    "check:changed": "bun run check:fast && bun run test:changed",
    "check:test": "bun run typecheck && bun run lint && bun run format:check && bun run test:run",
    "build:cached": "bun run compile && bun run artifacts:skills",
    "format": "bunx oxfmt .",
    "format:check": "bunx oxfmt --check .",
    "lint": "bun scripts/ci/static-check-report.mjs lint && bun run verify:module-boundaries && bun scripts/verify/rea-numeric-limits.mjs",
    "lint:details": "bunx oxlint && bun run verify:module-boundaries",
    "lint:fix": "bunx oxlint --fix && bun run verify:module-boundaries",
    "start": "bun scripts/rea.mjs mcp",
    "test": "bun run test:with-build",
    "test:with-build": "bun run test:prepare && bun --bun vitest run",
    "test:run": "bun --bun vitest run",
    "test:python": "uv run python scripts/run-python-tests.py",
    "eval:mcp-catalog": "uv run python tests/support/analysis-efficiency/catalog-eval.py",
    "test:local": "bun scripts/run-development-tests.mjs local",
    "test:fast": "bun scripts/ci/test-group.mjs source",
    "test:built": "bun scripts/ci/test-group.mjs built",
    "test:boundary": "bun --bun vitest run --project boundary --project cli-boundary --project process-boundary --project mcp-boundary --project process-global",
    "test:mcp": "bun --bun vitest run --project mcp-boundary",
    "test:acceptance": "bun --bun vitest run --project acceptance",
    "test:changed": "bun scripts/run-development-tests.mjs changed",
    "test:integration": "bun --bun vitest run --project boundary --project cli-boundary --project process-boundary --project mcp-boundary --project process-global --project acceptance",
    "test:coverage": "bun --bun vitest run --coverage.enabled --coverage.provider=v8",
    "test:coverage:reverse-tools": "bun --bun vitest run --config vitest.reverse-tools.config.ts --coverage.enabled",
    "test:ci": "bun run test:coverage -- --reporter=default --reporter=junit --outputFile.junit=test-results.xml",
    "test:ci:shard": "bun run test:ci:shard:run",
    "test:ci:shard:run": "bun --bun vitest run --coverage.enabled --coverage.provider=v8 --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0 --reporter=default --reporter=blob",
    "test:ci:merge": "bun --bun vitest --merge-reports --coverage.enabled --coverage.provider=v8",
    "test:verbose": "bun --bun vitest run --reporter=verbose",
    "test:watch": "bun --bun vitest --project domain --project services --project adapters --project composition --project conformance --project evaluation --changed",
    "test:watch:all": "bun --bun vitest --changed",
    "typecheck": "bun scripts/run-typescript.mjs --noEmit",
    "verify:test-temp-hygiene": "bun run test:prepare && bun scripts/verify-test-temp-hygiene.mjs",
    "verify:hopper": "bun run verify:fixtures && bun run build:cached && bun scripts/verify-real-hopper.mjs",
